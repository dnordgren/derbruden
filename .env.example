# Copy to .env and fill in. Never commit .env.
# espn_s2 and SWID must come from the SAME signed-in browser session:
# DevTools > Application > Cookies > https://fantasy.espn.com
# Trade data needs BOTH values. espn_s2 alone only reads basic league data.

LEAGUE_ID=794521
LEAGUE_YEAR=2026
ESPN_S2=
SWID=
DISCORD_WEBHOOK_URL=

# Optional
# STATE_FILE=static/data/trades-state.json
# NOTIFY_DECLINED=true
#   also list declined/vetoed trades on the web page.
#   Discord posts accepted trades only, regardless.
# LEAGUE_HOST=https://fantasy.espn.com
